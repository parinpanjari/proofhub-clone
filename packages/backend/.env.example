# ═══════════════════════════════════════
# ProofHub Clone — Backend Environment
# ═══════════════════════════════════════

# App
NODE_ENV=development
PORT=4000
FRONTEND_URL=http://localhost:5173

# Database (PostgreSQL 15)
DATABASE_URL=postgresql://proofhub:proofhub_secret@localhost:5432/proofhub

# Redis 7
REDIS_URL=redis://localhost:6379

# JWT Tokens
JWT_SECRET=change_this_secret_min_32_chars_long_random_string
JWT_REFRESH_SECRET=change_this_refresh_secret_different_from_above
JWT_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d

# SMTP Email
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your@email.com
SMTP_PASS=your_app_password
SMTP_FROM="ProofHub <noreply@yourcompany.com>"

# File Uploads
UPLOAD_DIR=./uploads
MAX_FILE_SIZE_MB=25

# CORS
ALLOWED_ORIGINS=http://localhost:5173

# Rate Limiting
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX=100
